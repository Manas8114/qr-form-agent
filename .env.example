# .env.example - qr-form-agent configuration

# Run pipeline without making live submissions or network writes
DRY_RUN=false

# Enable debug logs
DEBUG=false

# Storage & Database
DATA_DIR=./data
DATABASE_URL=sqlite:///./data/qr_agent.db

# LLM Providers (for resume extraction and Tier 2 field mapping)
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
LLM_PROVIDER=anthropic
LLM_MODEL=claude-3-5-sonnet-20241022

# Security & Mapping Thresholds
CONFIDENCE_THRESHOLD=0.75
RATE_LIMIT_PER_DOMAIN_SECONDS=2.0

# Review UI Server
REVIEW_SERVER_HOST=127.0.0.1
REVIEW_SERVER_PORT=8000

# Optional Telegram Notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
